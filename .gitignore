target/

# mkdocs build output (generated by `mkdocs build`; the Pages workflow builds it in CI)
/site/

# Independent oracle tooling for the deleted-record head-to-head
# (docs/recovery-comparison.md). The bulky third-party upstream checkouts/builds
# under tools/ are NOT committed — download each per its tools/<tool>/SETUP.md.
# The small reproducibility artifacts we authored (patches, shims, the fqlite tap
# source, SETUP recipes) ARE committed so the comparison reproduces independently.
# Provenance: docs/corpus-catalog.md §F and docs/validation.md.
/tools/*
!/tools/*/
!/tools/README.md

/tools/undark/*
!/tools/undark/undark.patch
!/tools/undark/SETUP.md

/tools/bring2lite/*
!/tools/bring2lite/bring2lite.patch
!/tools/bring2lite/SETUP.md
!/tools/bring2lite/shim/

/tools/fqlite/*
!/tools/fqlite/fqlite.patch
!/tools/fqlite/SETUP.md
!/tools/fqlite/run-tap.sh
!/tools/fqlite/tap/
!/tools/fqlite/stubs/

# Third-party validation corpus: the DBs are NOT committed (provenance + hashes
# recorded in tests-oracle-corpus/README.md and docs/corpus-catalog.md), but the
# README that records that provenance IS committed.
/tests-oracle-corpus/*
!/tests-oracle-corpus/README.md

# Reference papers: copyrighted academic PDFs cited in the design/docs are NOT
# committed or redistributed; their citations are recorded in
# docs/references/README.md, which IS committed.
/docs/references/*
!/docs/references/README.md

# Large (~100 MB) throughput-benchmark database + its ground-truth manifest:
# generated by tests/data/paper_fp/gen_large.py, gitignored like the other large
# corpus artifacts (documented in docs/corpus-catalog.md). The generator script
# IS committed; the generated DB is not.
/tests/data/paper_fp/large_messages.db
/tests/data/paper_fp/large_messages.db-*
/tests/data/paper_fp/*.db.deleted.json

# Belkasoft "SQLite Exercises" training corpus — real-world messenger app data
# (WhatsApp/Viber/Skype/Facebook/Safari/CarPlay). Belkasoft's Terms of Use PROHIBIT
# redistribution, so the archive/extracted DBs are NEVER committed; provenance +
# hashes live in tests/data/belkasoft/README.md and docs/corpus-catalog.md §Q.
/tests/data/belkasoft/*
!/tests/data/belkasoft/README.md
# NIST CFReDS SQLite corpus: the small ground-truth fixtures ARE committed
# (public-domain; provenance in tests/data/cfreds/README.md + docs/corpus-catalog.md).
# Only the large SFT-05 BLOB databases (~206 MB each) are gitignored — download
# per tests/data/cfreds/README.md. A blanket ignore of the whole cfreds/ dir made
# the committed fixtures "committed AND ignored", which fails release-plz's
# `git ls-files -ci` working-tree check.
/tests/data/cfreds/SFT-05_android.sqlite
/tests/data/cfreds/SFT-05_ios.sqlite
/tests/data/*.sqlite
