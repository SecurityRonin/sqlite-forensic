 #function to remove the non-printable characters, tabs and white spaces
 def remove_ascii_non_printable(chunk):
+    # Py3: file opened "rb", so `chunk` is `bytes` -> iterate raw byte values
+    # (ints; original ord(ch) would raise), keep printable ASCII + tab, decode.
+    if isinstance(chunk, (bytes, bytearray)):
+        chunk = bytes(b for b in chunk if (b > 31 and b < 126) or b == 9).decode('ascii', 'replace')
     chunk = ' '.join(chunk .split())
     return ''.join([ch for ch in chunk if ord(ch) > 31 and ord(ch) < 126 or ord(ch) ==9])
 
