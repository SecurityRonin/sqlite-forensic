 #define DECODE_MODE_FREESPACE 1
 #define DECODE_MODE_NORMAL 0
+
+/* Hoisted out of decode_row(): clang rejects GCC nested functions. ntohll
+ * renamed -> u_ntohll to avoid the macOS <sys/_endian.h> ntohll macro. */
+static uint64_t swap64(uint64_t x) {
+	uint8_t i;
+	uint64_t y;
+	uint8_t *px, *py;
+
+	px = (uint8_t *)&x;
+	py = (uint8_t *)&y;
+
+	for (i=0; i<8; i++) {
+		*(py+i) = *(px +(7-i));
+	}
+	return y;
+}
 
+static uint64_t u_ntohll(uint64_t value) {
+	uint64_t t;
+	if (1==ntohl(1)) {
+		return value;
+	} else {
+		t = swap64(value);
+		return t;
+	}
+}
+
